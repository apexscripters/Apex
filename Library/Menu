--  icon-only sidebar, cards, minimal, expansível, top+subtab,
--  centered, hybrid. Compartilham todo o Core acima.)

local function makeSimpleLibrary(layoutName, layoutFn)
    return function(globalCfg)
        local theme=ThemeEngine:get()
        local function CreateWindow(cfg)
            local W=cfg.Size and cfg.Size.X.Offset or 390
            local H=cfg.Size and cfg.Size.Y.Offset or 430
            local janitor=ConnectionManager.new()
            local sg=Util.new("ScreenGui",{
                Name="Apex_"..layoutName,ResetOnSpawn=false,
                ZIndexBehavior=Enum.ZIndexBehavior.Sibling},pg)
            janitor:add(sg)
            layoutFn(sg,cfg,W,H,theme,janitor)
            -- retorna winAPI genérico com CreateWindow de L01
            return Library01(globalCfg).CreateWindow(cfg)
        end
        return {CreateWindow=CreateWindow}
    end
end

