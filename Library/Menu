local Apex = {}
Apex.Flags     = StateManager.Flags
Apex._library  = 1  -- qual variante usar por padrão
Apex._janitor  = ConnectionManager.new()
Apex._config   = {
    Theme          = "Midnight",
    Accent         = Color3.fromRGB(108,99,255),
    Font           = Enum.Font.Gotham,
    CornerRadius   = 8,
    AnimationSpeed = 1,
    Transparency   = 0,
    UIScale        = 1,
}

function Apex:SetConfig(cfg)
    for k,v in pairs(cfg) do self._config[k]=v end
    if cfg.Theme then ThemeEngine:set(cfg.Theme) end
    if cfg.AnimationSpeed then AnimCtrl:setSpeed(cfg.AnimationSpeed) end
end

function Apex:SetTheme(name)    ThemeEngine:set(name) end
function Apex:RegisterTheme(name,data) ThemeEngine:register(name,data) end
function Apex:SetAccent(c)      ThemeEngine._themes[ThemeEngine._active].Accent=c end
function Apex:SetAnimationSpeed(s) AnimCtrl:setSpeed(s) end
function Apex:SetReducedMotion(v)  AnimCtrl:setReduced(v) end
function Apex:SetUIScale(s)     self._config.UIScale=s end

function Apex:CreateWindow(cfg)
    if cfg.Theme then ThemeEngine:set(cfg.Theme) end
    local lib=LibraryVariants[self._library] or Library01
    return lib(self._config).CreateWindow(cfg)
end

function Apex:Notify(cfg)
    NotifSystem:push(cfg)
end

function Apex:UseLibrary(n)
    self._library=math.clamp(n,1,10)
end

function Apex:Destroy()
    self._janitor:clean()
    Rainbow:stop()
    for _,v in ipairs(pg:GetChildren()) do
        if v.Name:sub(1,5)=="Apex_" then pcall(function() v:Destroy() end) end
    end
end

