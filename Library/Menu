        BackgroundTransparency=1,Text=cfg.Name or "Slider",
        TextSize=12,Font=Enum.Font.GothamBold,
        TextColor3=theme.Text,TextXAlignment=Enum.TextXAlignment.Left,ZIndex=9,Parent=f
    })
    Rainbow:add(nameLbl, math.random())

    local valLbl=Util.new("TextLabel",{
        Size=UDim2.new(0.33,0,0,18),Position=UDim2.new(0.65,0,0,6),
        BackgroundTransparency=1,Text=tostring(val),
        TextSize=12,Font=Enum.Font.GothamBold,
        TextColor3=theme.Accent,TextXAlignment=Enum.TextXAlignment.Right,ZIndex=9,Parent=f
    })

    local trk=Util.new("Frame",{
        Size=UDim2.new(1,-24,0,5),Position=UDim2.new(0,12,0,30),
        BackgroundColor3=theme.Surface2,ZIndex=9,Parent=f
    })
    Util.corner(trk,3)
    local rel0=(val-mn)/(mx-mn)
    local fill=Util.new("Frame",{
        Size=UDim2.new(rel0,0,1,0),
        BackgroundColor3=theme.Accent,ZIndex=10,Parent=trk
    })
    Util.corner(fill,3)
    local kn=Util.new("Frame",{
        Size=UDim2.new(0,13,0,13),
        Position=UDim2.new(rel0,-6,0.5,-6),
        BackgroundColor3=Color3.fromRGB(255,255,255),ZIndex=11,Parent=trk
    })
    Util.corner(kn,7)
    Util.stroke(kn,theme.Accent,1.5)

    local _events = {}
    local _destroyed = false
    local dragging=false

    local function applyRel(rel)
        rel=Util.clamp(rel,0,1)
        local raw=mn+(mx-mn)*rel
        local snapped=math.floor(raw/inc+.5)*inc
        val=Util.clamp(Util.round(snapped,2),mn,mx)
        valLbl.Text=tostring(val)
        fill.Size=UDim2.new(rel,0,1,0)
        kn.Position=UDim2.new(rel,-6,0.5,-6)
        if cfg.Flag then StateManager:set(cfg.Flag,val) end
        if cfg.Callback and not _destroyed then pcall(cfg.Callback,val) end
        for _,fn in ipairs(_events) do pcall(fn,val) end
    end

    local c1=kn.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1
        or i.UserInputType==Enum.UserInputType.Touch then dragging=true end
    end)
    local c2=UIS.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1
        or i.UserInputType==Enum.UserInputType.Touch then dragging=false end
    end)
    local c3=UIS.InputChanged:Connect(function(i)
        if not dragging then return end
        if i.UserInputType~=Enum.UserInputType.MouseMovement
        and i.UserInputType~=Enum.UserInputType.Touch then return end
        local rel=(i.Position.X-trk.AbsolutePosition.X)/trk.AbsoluteSize.X
        applyRel(rel)
    end)
    local c4=f.MouseEnter:Connect(function() AnimCtrl:tween(f,{BackgroundColor3=theme.Surface2}) end)
    local c5=f.MouseLeave:Connect(function() AnimCtrl:tween(f,{BackgroundColor3=theme.Surface}) end)
    janitor:add(c1);janitor:add(c2);janitor:add(c3);janitor:add(c4);janitor:add(c5)

    local obj={_frame=f}
    function obj:Set(v)
        applyRel((Util.clamp(v,mn,mx)-mn)/(mx-mn))
    end
    function obj:Get() return val end
    function obj:OnChanged(fn) _events[#_events+1]=fn end
    function obj:SetVisible(v) f.Visible=v end
    function obj:SetDisabled(v)
        c3:Disconnect()
        AnimCtrl:tween(f,{BackgroundTransparency=v and 0.4 or 0})
    end
    function obj:Destroy() _destroyed=true; f:Destroy() end
    return obj
end

