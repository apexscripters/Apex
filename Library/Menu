-- 4. ANIMATION CONTROLLER
-- ══════════════════════════════════════════════════════════════
local AnimCtrl = {}
AnimCtrl._speed = 1
AnimCtrl._reduced = false

function AnimCtrl:setSpeed(s) self._speed = s end
function AnimCtrl:setReduced(v) self._reduced = v end

function AnimCtrl:tween(obj, props, dur, style, dir)
    if self._reduced then
        for k,v in pairs(props) do pcall(function() obj[k]=v end) end
        return
    end
    local t = (dur or 0.18) / self._speed
    TweenService:Create(obj,
        TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out),
        props):Play()
end

function AnimCtrl:spring(obj, props, dur)
    self:tween(obj, props, dur or 0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
end

