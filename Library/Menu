-- 2. CONNECTION MANAGER (Janitor / Maid pattern)
-- ══════════════════════════════════════════════════════════════
local ConnectionManager = {}
ConnectionManager.__index = ConnectionManager

function ConnectionManager.new()
    return setmetatable({_items={}}, ConnectionManager)
end

function ConnectionManager:add(item)
    self._items[#self._items+1] = item
    return item
end

function ConnectionManager:addFn(fn)
    self._items[#self._items+1] = {_fn=fn}
    return fn
end

function ConnectionManager:clean()
    for _,item in ipairs(self._items) do
        if typeof(item)=="RBXScriptConnection" then
            pcall(function() item:Disconnect() end)
        elseif typeof(item)=="Instance" then
            pcall(function() item:Destroy() end)
        elseif type(item)=="table" and item._fn then
            pcall(item._fn)
        elseif type(item)=="function" then
            pcall(item)
        end
    end
    self._items = {}
end

