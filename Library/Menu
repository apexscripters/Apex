-- 8. RAINBOW SYSTEM (centralizado, eficiente)
-- ══════════════════════════════════════════════════════════════
local Rainbow = {}
Rainbow._hue       = 0
Rainbow._labels    = {}
Rainbow._active    = false
Rainbow._conn      = nil

function Rainbow:add(lbl, offset)
    self._labels[lbl] = offset or (math.random() % 1)
    if not self._active then self:start() end
end

function Rainbow:remove(lbl)
    self._labels[lbl] = nil
end

function Rainbow:start()
    if self._active then return end
    self._active = true
    self._conn = RunService.Heartbeat:Connect(function(dt)
        self._hue = (self._hue + dt * 0.38) % 1
        for lbl, off in pairs(self._labels) do
            if lbl and lbl.Parent then
                lbl.TextColor3 = Color3.fromHSV((self._hue + off) % 1, 0.82, 1)
            else
                self._labels[lbl] = nil
            end
        end
    end)
end

function Rainbow:stop()
    if self._conn then self._conn:Disconnect(); self._conn=nil end
    self._active = false
end

