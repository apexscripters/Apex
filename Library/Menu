local Util = {}

function Util.new(cls, props, parent)
    local o = Instance.new(cls)
    if props then for k,v in pairs(props) do o[k]=v end end
    if parent then o.Parent=parent end
    return o
end

function Util.corner(p, r)
    return Util.new("UICorner",{CornerRadius=UDim.new(0,r or 8)},p)
end

function Util.stroke(p, color, thick)
    return Util.new("UIStroke",{Color=color or Color3.new(),Thickness=thick or 1},p)
end

function Util.pad(p, t,b,l,r)
    local u = Instance.new("UIPadding"); u.Parent=p
    if t then u.PaddingTop    = UDim.new(0,t) end
    if b then u.PaddingBottom = UDim.new(0,b) end
    if l then u.PaddingLeft   = UDim.new(0,l) end
    if r then u.PaddingRight  = UDim.new(0,r) end
    return u
end

function Util.listLayout(p, dir, pad, align)
    return Util.new("UIListLayout",{
        FillDirection = dir or Enum.FillDirection.Vertical,
        Padding       = UDim.new(0, pad or 6),
        SortOrder     = Enum.SortOrder.LayoutOrder,
        HorizontalAlignment = align or Enum.HorizontalAlignment.Left
    }, p)
end

function Util.clamp(v,mn,mx) return math.max(mn,math.min(mx,v)) end
function Util.round(v,n) local f=10^(n or 0); return math.floor(v*f+.5)/f end
function Util.lerp(a,b,t) return a+(b-a)*t end

