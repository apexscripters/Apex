        end)

        clsB.MouseButton1Click:Connect(function()
            AnimCtrl:tween(win,{Size=UDim2.new(0,W,0,0)},0.15)
            task.delay(0.16,function()
                janitor:clean()
                if toggleSG then toggleSG:Destroy() end
            end)
        end)

        -- Window API
        local winAPI={}
        function winAPI:CreateTab(tabCfg)
            local name=tabCfg.Name or ("Tab"..#tabBtns+1)
            local icon=tabCfg.Icon or ""

            local tb=Util.new("TextButton",{
                Size=UDim2.new(0,0,1,0),AutomaticSize=Enum.AutomaticSize.X,
                BackgroundTransparency=1,Text=(icon~="" and icon.." " or "")..name,
                TextSize=11,Font=Enum.Font.GothamBold,
                TextColor3=theme.TextMuted,ZIndex=7,Parent=tabBar
            })
            Util.corner(tb,5)
            Util.pad(tb,0,0,8,8)

            local page=buildPage()
            tabPages[name]=page; tabBtns[name]=tb

            if not activeTab then selectTab(name) end
            tb.MouseButton1Click:Connect(function() selectTab(name) end)

            return makeTabAPI(page, theme, janitor)
        end

        function winAPI:SetTitle(v) titleLbl.Text=v end
        function winAPI:SetVisible(v) sg.Enabled=v end
        function winAPI:Toggle() sg.Enabled=not sg.Enabled end
        function winAPI:Minimize() minB.MouseButton1Click:Fire() end
        function winAPI:Restore() restore() end
        function winAPI:IsMinimized() return minimized end
        function winAPI:Destroy() janitor:clean() end

        return winAPI
    end

    return {CreateWindow=CreateWindow}
end

