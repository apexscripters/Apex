-- 11. TAB API
-- ══════════════════════════════════════════════════════════════
local function makeTabAPI(scrollFrame, theme, janitor)
    local order = 0
    local api   = {_scroll=scrollFrame}

    local function nextOrder() order=order+1; return order end

    function api:CreateSection(name)
        return Components.Section(scrollFrame, name, nextOrder(), theme)
    end
    function api:CreateDivider()
        return Components.Divider(scrollFrame, nextOrder(), theme)
    end
    function api:CreateLabel(cfg)
        return Components.Label(scrollFrame, cfg, nextOrder(), theme, janitor)
    end
    function api:CreateButton(cfg)
        return Components.Button(scrollFrame, cfg, nextOrder(), theme, janitor)
    end
    function api:CreateToggle(cfg)
        return Components.Toggle(scrollFrame, cfg, nextOrder(), theme, janitor)
    end
    function api:CreateSlider(cfg)
        return Components.Slider(scrollFrame, cfg, nextOrder(), theme, janitor)
    end
    function api:CreateDropdown(cfg)
        return Components.Dropdown(scrollFrame, cfg, nextOrder(), theme, janitor)
    end
    function api:CreateInput(cfg)
        return Components.Input(scrollFrame, cfg, nextOrder(), theme, janitor)
    end

    return api
end

