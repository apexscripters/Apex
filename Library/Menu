-- L07 — Sidebar expansível (usa L02 com largura variável)
local function Library07(globalCfg)
    local theme=ThemeEngine:get()
    local function CreateWindow(cfg)
        local expanded=false
        local W=cfg.Size and cfg.Size.X.Offset or 400
        local H=cfg.Size and cfg.Size.Y.Offset or 440
        local janitor=ConnectionManager.new()
        local sg=Util.new("ScreenGui",{Name="Apex_L07",ResetOnSpawn=false,
            ZIndexBehavior=Enum.ZIndexBehavior.Sibling},pg)
        janitor:add(sg)
        local win=Util.new("Frame",{Size=UDim2.new(0,W,0,0),
            Position=UDim2.new(0.5,-W/2,0.5,-H/2),
            BackgroundColor3=theme.Background,BorderSizePixel=0,
            ZIndex=5,ClipsDescendants=true,Parent=sg})
        Util.corner(win,12); Util.stroke(win,theme.Accent,1.5)
        Util.new("ImageLabel",{Size=UDim2.new(1,0,1,0),BackgroundTransparency=1,
            Image=AssetManager:get("hacker"),ImageTransparency=0.93,
            ScaleType=Enum.ScaleType.Crop,ZIndex=5,Parent=win})

        local SIDE_COLLAPSED=52; local SIDE_EXPANDED=130

        local sidebar=Util.new("Frame",{Size=UDim2.new(0,SIDE_COLLAPSED,1,0),
            BackgroundColor3=theme.Surface,BorderSizePixel=0,
            ZIndex=6,ClipsDescendants=true,Parent=win})
        Util.corner(sidebar,12)
        Util.new("Frame",{Size=UDim2.new(0,12,1,0),Position=UDim2.new(1,-12,0,0),
            BackgroundColor3=theme.Surface,BorderSizePixel=0,ZIndex=6,Parent=sidebar})
        Util.new("Frame",{Size=UDim2.new(0,1,1,0),Position=UDim2.new(1,-1,0,0),
            BackgroundColor3=theme.Border,BorderSizePixel=0,ZIndex=7,Parent=sidebar})

        -- botão expandir
        local expBtn=Util.new("TextButton",{Size=UDim2.new(0,32,0,32),
            Position=UDim2.new(0.5,-16,0,9),BackgroundColor3=theme.Surface2,
            Text="☰",TextSize=14,Font=Enum.Font.GothamBold,
            TextColor3=theme.Accent,ZIndex=7,Parent=sidebar})
        Util.corner(expBtn,8)
        expBtn.MouseButton1Click:Connect(function()
            expanded=not expanded
            local sw=expanded and SIDE_EXPANDED or SIDE_COLLAPSED
            AnimCtrl:tween(sidebar,{Size=UDim2.new(0,sw,1,0)})
            expBtn.Text=expanded and "✕" or "☰"
        end)

        Util.listLayout(sidebar,nil,4)
        Util.pad(sidebar,52,6,4,4)

        local hdr=Util.new("Frame",{Size=UDim2.new(1,-SIDE_COLLAPSED,0,44),
            Position=UDim2.new(0,SIDE_COLLAPSED,0,0),BackgroundColor3=theme.Surface,
            BorderSizePixel=0,ZIndex=6,Parent=win})
        Util.new("Frame",{Size=UDim2.new(1,0,0,1),Position=UDim2.new(0,0,1,-1),
            BackgroundColor3=theme.Border,BorderSizePixel=0,ZIndex=7,Parent=hdr})
        local titleLbl=Util.new("TextLabel",{Size=UDim2.new(1,-60,1,0),
            Position=UDim2.new(0,12,0,0),BackgroundTransparency=1,Text=cfg.Name or "Apex",
            TextSize=13,Font=Enum.Font.GothamBold,
            TextXAlignment=Enum.TextXAlignment.Left,ZIndex=7,Parent=hdr})
        Rainbow:add(titleLbl,0)
        local clsB=Util.new("TextButton",{Size=UDim2.new(0,22,0,22),
            Position=UDim2.new(1,-28,0.5,-11),BackgroundColor3=Color3.fromRGB(200,45,45),
            Text="✕",TextSize=10,Font=Enum.Font.GothamBold,
            TextColor3=Color3.fromRGB(255,255,255),ZIndex=8,Parent=hdr})
        Util.corner(clsB,5)
        local minB=Util.new("TextButton",{Size=UDim2.new(0,22,0,22),
            Position=UDim2.new(1,-54,0.5,-11),BackgroundColor3=theme.Surface2,
            Text="—",TextSize=10,Font=Enum.Font.GothamBold,
            TextColor3=theme.TextMuted,ZIndex=8,Parent=hdr})
        Util.corner(minB,5)

        local scroll=Util.new("ScrollingFrame",{
            Size=UDim2.new(1,-SIDE_COLLAPSED,1,-46),
            Position=UDim2.new(0,SIDE_COLLAPSED,0,46),
            BackgroundTransparency=1,BorderSizePixel=0,
            ScrollBarThickness=2,ScrollBarImageColor3=theme.Accent,
            CanvasSize=UDim2.new(0,0,0,0),AutomaticCanvasSize=Enum.AutomaticSize.Y,
            ZIndex=6,Parent=win})
        Util.listLayout(scroll,nil,5)
        Util.pad(scroll,8,8,10,10)

        DragController(win,hdr,janitor)
        AnimCtrl:spring(win,{Size=UDim2.new(0,W,0,H)})

        local tabPages,tabBtns,activeTab={},{},nil
        local function selectTab(name)
            for n,p in pairs(tabPages) do p.Visible=(n==name) end
            for n,b in pairs(tabBtns) do
                local act=(n==name)
                AnimCtrl:tween(b,{BackgroundColor3=act and theme.Accent or Color3.new(),
                    BackgroundTransparency=act and 0 or 1})
                b.TextColor3=act and Color3.fromRGB(255,255,255) or theme.TextMuted
            end
            activeTab=name
        end

        local toggleSG=nil
        local function restore()
            if toggleSG then toggleSG:Destroy();toggleSG=nil end
            sg.Enabled=true; win.Size=UDim2.new(0,W,0,0)
            AnimCtrl:spring(win,{Size=UDim2.new(0,W,0,H)})
        end
        minB.MouseButton1Click:Connect(function()
            AnimCtrl:tween(win,{Size=UDim2.new(0,W,0,0)}); task.wait(0.16)
            sg.Enabled=false
            toggleSG=Util.new("ScreenGui",{Name="Apex_Toggle",ResetOnSpawn=false,
                ZIndexBehavior=Enum.ZIndexBehavior.Sibling},pg)
            local tb=Util.new("ImageButton",{Size=UDim2.new(0,52,0,52),
                Position=UDim2.new(0,16,0.5,-26),BackgroundColor3=theme.Background,
                Image=AssetManager:get("hacker"),ImageTransparency=0.2,
                ScaleType=Enum.ScaleType.Crop,ZIndex=20,Parent=toggleSG})
            Util.corner(tb,14); Util.stroke(tb,theme.Accent,2)
            Rainbow:add(Util.new("TextLabel",{Size=UDim2.new(1,0,1,0),BackgroundTransparency=1,
                Text="⚡",TextSize=22,Font=Enum.Font.GothamBold,ZIndex=21,Parent=tb}))
            DragController(tb,tb,janitor); tb.MouseButton1Click:Connect(restore)
        end)
        clsB.MouseButton1Click:Connect(function()
            AnimCtrl:tween(win,{Size=UDim2.new(0,W,0,0)},0.15)
            task.delay(0.16,function() janitor:clean() end)
        end)

        local winAPI={}
        function winAPI:CreateTab(tabCfg)
            local name=tabCfg.Name or "Tab"
            local icon=tabCfg.Icon or "●"
            local tb=Util.new("TextButton",{Size=UDim2.new(1,0,0,38),
                BackgroundTransparency=1,Text=icon.."  "..name,TextSize=11,
                Font=Enum.Font.GothamBold,TextColor3=theme.TextMuted,
                TextXAlignment=Enum.TextXAlignment.Left,ZIndex=7,Parent=sidebar})
            Util.corner(tb,7); Util.pad(tb,0,0,10,0)
            local page=Util.new("Frame",{Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,
                BackgroundTransparency=1,Visible=false,ZIndex=6,Parent=scroll})
            Util.listLayout(page,nil,5)
            tabPages[name]=page; tabBtns[name]=tb
            if not activeTab then selectTab(name) end
            tb.MouseButton1Click:Connect(function() selectTab(name) end)
            return makeTabAPI(page,theme,janitor)
        end
        function winAPI:SetTitle(v) titleLbl.Text=v end
        function winAPI:Destroy() janitor:clean() end
        return winAPI
    end
    return {CreateWindow=CreateWindow}
end

-- L08, L09, L10 — reusam Library01 com accents/temas próprios
-- (a arquitetura permite criar layouts distintos; aqui entregamos
-- a API completa e funcional com variações de accent/tema)
local function makeFinalLib(n)
    local accents={
        [8]  = Color3.fromRGB(150,160,220),
        [9]  = Color3.fromRGB(0,220,140),
        [10] = Color3.fromRGB(255,215,0),
    }
    return function(globalCfg)
        local theme=ThemeEngine:get()
        -- sobrepõe accent
        local savedAcc=theme.Accent
        theme.Accent=accents[n] or theme.Accent
        local lib=Library01(globalCfg)
        theme.Accent=savedAcc
        return lib
    end
end

