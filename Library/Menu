function Components.Button(parent, cfg, order, theme, janitor)
    local f = Util.new("Frame",{
        Size=UDim2.new(1,0,0,34),LayoutOrder=order,
        BackgroundColor3=theme.Surface,BorderSizePixel=0,ZIndex=8,Parent=parent
    })
    Util.corner(f,8)
    Util.stroke(f, theme.Border, 1)

    local nameLbl=Util.new("TextLabel",{
        Size=UDim2.new(1,-80,1,0),Position=UDim2.new(0,12,0,0),
        BackgroundTransparency=1,Text=cfg.Name or "Button",
        TextSize=12,Font=Enum.Font.GothamBold,
        TextColor3=theme.Text,TextXAlignment=Enum.TextXAlignment.Left,
        ZIndex=9,Parent=f
    })
    Rainbow:add(nameLbl, math.random())

    local btn=Util.new("TextButton",{
        Size=UDim2.new(0,58,0,24),Position=UDim2.new(1,-64,0.5,-12),
        BackgroundColor3=theme.Accent,Text="Executar",TextSize=10,
        Font=Enum.Font.GothamBold,TextColor3=Color3.fromRGB(255,255,255),
        ZIndex=10,Parent=f
    })
    Util.corner(btn,6)

    local _events = {}
    local _destroyed = false

    local function fire()
        if _destroyed then return end
        AnimCtrl:tween(btn,{BackgroundColor3=theme.AccentHover})
        task.delay(0.12,function() AnimCtrl:tween(btn,{BackgroundColor3=theme.Accent}) end)
        if cfg.Callback then pcall(cfg.Callback) end
        for _,fn in ipairs(_events) do pcall(fn) end
    end

    local c1=btn.MouseButton1Click:Connect(fire)
    local c2=btn.MouseEnter:Connect(function() AnimCtrl:tween(f,{BackgroundColor3=theme.Surface2}) end)
    local c3=btn.MouseLeave:Connect(function() AnimCtrl:tween(f,{BackgroundColor3=theme.Surface}) end)
    janitor:add(c1); janitor:add(c2); janitor:add(c3)

    local obj={_frame=f}
    function obj:OnClicked(fn) _events[#_events+1]=fn end
    function obj:SetText(v) nameLbl.Text=v end
    function obj:SetVisible(v) f.Visible=v end
    function obj:SetDisabled(v)
        btn.Active=not v
        AnimCtrl:tween(btn,{BackgroundTransparency=v and 0.5 or 0})
    end
    function obj:Destroy() _destroyed=true; f:Destroy() end
    return obj
end

-- ── Toggle ───────────────────────────────────────────────────
function Components.Toggle(parent, cfg, order, theme, janitor)
    local state = cfg.CurrentValue or false
    local f = Util.new("Frame",{
        Size=UDim2.new(1,0,0,38),LayoutOrder=order,
        BackgroundColor3=theme.Surface,BorderSizePixel=0,ZIndex=8,Parent=parent
    })
    Util.corner(f,8)
    Util.stroke(f,theme.Border,1)

    local nameLbl=Util.new("TextLabel",{
        Size=UDim2.new(1,-60,0,18),Position=UDim2.new(0,12,0,6),
        BackgroundTransparency=1,Text=cfg.Name or "Toggle",
        TextSize=12,Font=Enum.Font.GothamBold,
        TextColor3=theme.Text,TextXAlignment=Enum.TextXAlignment.Left,ZIndex=9,Parent=f
    })
    Rainbow:add(nameLbl, math.random())

    if cfg.Description then
        Util.new("TextLabel",{
            Size=UDim2.new(1,-60,0,13),Position=UDim2.new(0,12,0,22),
            BackgroundTransparency=1,Text=cfg.Description,
            TextSize=10,Font=Enum.Font.Gotham,TextColor3=theme.TextMuted,
            TextXAlignment=Enum.TextXAlignment.Left,ZIndex=9,Parent=f
        })
        f.Size=UDim2.new(1,0,0,48)
    end

    local track=Util.new("Frame",{
        Size=UDim2.new(0,38,0,20),Position=UDim2.new(1,-46,0.5,-10),
        BackgroundColor3=state and theme.Accent or theme.Surface2,ZIndex=9,Parent=f
    })
    Util.corner(track,10)
    local knob=Util.new("Frame",{
        Size=UDim2.new(0,14,0,14),
        Position=state and UDim2.new(1,-17,0.5,-7) or UDim2.new(0,3,0.5,-7),
        BackgroundColor3=Color3.fromRGB(255,255,255),ZIndex=10,Parent=track
    })
    Util.corner(knob,7)

    local _events = {}
    local _destroyed = false

    local function apply(s)
        state=s
        AnimCtrl:tween(track,{BackgroundColor3=s and theme.Accent or theme.Surface2})
        AnimCtrl:tween(knob,{Position=s and UDim2.new(1,-17,0.5,-7) or UDim2.new(0,3,0.5,-7)})
        if cfg.Flag then StateManager:set(cfg.Flag, s) end
        if cfg.Callback and not _destroyed then pcall(cfg.Callback,s) end
        for _,fn in ipairs(_events) do pcall(fn,s) end
    end

    local cl=Util.new("TextButton",{Size=UDim2.new(1,0,1,0),BackgroundTransparency=1,
        Text="",ZIndex=11,Parent=f})
    local c1=cl.MouseButton1Click:Connect(function() apply(not state) end)
    local c2=f.MouseEnter:Connect(function() AnimCtrl:tween(f,{BackgroundColor3=theme.Surface2}) end)
    local c3=f.MouseLeave:Connect(function() AnimCtrl:tween(f,{BackgroundColor3=theme.Surface}) end)
    janitor:add(c1); janitor:add(c2); janitor:add(c3)

    local obj={_frame=f}
    function obj:Set(v)    apply(v) end
    function obj:Get()     return state end
    function obj:OnChanged(fn) _events[#_events+1]=fn end
    function obj:SetText(v) nameLbl.Text=v end
    function obj:SetVisible(v) f.Visible=v end
    function obj:SetDisabled(v) cl.Active=not v; AnimCtrl:tween(f,{BackgroundTransparency=v and 0.4 or 0}) end
    function obj:Destroy() _destroyed=true; f:Destroy() end
    return obj
end

