-- 5. DRAG CONTROLLER
-- ══════════════════════════════════════════════════════════════
local function DragController(win, handle, janitor)
    local dragging = false
    local startMousePos, startWinPos

    local function getPos(i)
        return i.Position
    end

    local c1 = handle.InputBegan:Connect(function(i)
        if i.UserInputType ~= Enum.UserInputType.MouseButton1
        and i.UserInputType ~= Enum.UserInputType.Touch then return end
        dragging = true
        startMousePos = getPos(i)
        startWinPos   = win.Position
    end)

    local c2 = UIS.InputChanged:Connect(function(i)
        if not dragging then return end
        if i.UserInputType ~= Enum.UserInputType.MouseMovement
        and i.UserInputType ~= Enum.UserInputType.Touch then return end

        local delta = getPos(i) - startMousePos
        local vp    = workspace.CurrentCamera.ViewportSize
        local newX  = Util.clamp(startWinPos.X.Offset + delta.X, 0, vp.X - win.AbsoluteSize.X)
        local newY  = Util.clamp(startWinPos.Y.Offset + delta.Y, 0, vp.Y - win.AbsoluteSize.Y)
        win.Position = UDim2.new(0, newX, 0, newY)
    end)

    local c3 = UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    if janitor then janitor:add(c1); janitor:add(c2); janitor:add(c3) end
end

