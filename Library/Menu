    end)
    local c2=box.FocusLost:Connect(function(enter)
        value=box.Text
        AnimCtrl:tween(box,{BackgroundColor3=theme.Surface2})
        if cfg.Flag then StateManager:set(cfg.Flag,value) end
        if cfg.Callback and not _destroyed then pcall(cfg.Callback,value,enter) end
        for _,fn in ipairs(_events) do pcall(fn,value) end
    end)
    janitor:add(c1);janitor:add(c2)

    local obj={_frame=f}
    function obj:Set(v) box.Text=v; value=v end
    function obj:Get() return value end
    function obj:OnChanged(fn) _events[#_events+1]=fn end
    function obj:SetVisible(v) f.Visible=v end
    function obj:Destroy() _destroyed=true; f:Destroy() end
    return obj
end

