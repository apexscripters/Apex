-- 9. NOTIFICATION SYSTEM
-- ══════════════════════════════════════════════════════════════
local NotifSystem = {}
NotifSystem._sg = nil
NotifSystem._stack = {}
NotifSystem._gap = 8

function NotifSystem:_ensure()
    if self._sg and self._sg.Parent then return end
    self._sg = Util.new("ScreenGui",{
        Name="ApexNotifs", ResetOnSpawn=false,
        ZIndexBehavior=Enum.ZIndexBehavior.Sibling,
        IgnoreGuiInset=true
    }, pg)
end

function NotifSystem:push(cfg)
    self:_ensure()
    local dur   = cfg.Duration or 4
    local theme = ThemeEngine:get()

    local card = Util.new("Frame",{
        Size=UDim2.new(0,260,0,0),
        Position=UDim2.new(1,-270,1,-10),
        BackgroundColor3=theme.Surface,
        BackgroundTransparency=0.05,
        ClipsDescendants=true,
        ZIndex=50,
        Parent=self._sg
    })
    Util.corner(card,10)
    Util.stroke(card, theme.Accent, 1)

    -- accent bar
    Util.new("Frame",{Size=UDim2.new(0,3,1,0),
        BackgroundColor3=theme.Accent,BorderSizePixel=0,ZIndex=51,Parent=card})

    local inner = Util.new("Frame",{
        Size=UDim2.new(1,-12,1,0),Position=UDim2.new(0,10,0,0),
        BackgroundTransparency=1,ZIndex=51,Parent=card
    })
    local title = Util.new("TextLabel",{
        Size=UDim2.new(1,0,0,18),Position=UDim2.new(0,0,0,8),
        BackgroundTransparency=1,
        Text=cfg.Title or "Apex",
        TextSize=13,Font=Enum.Font.GothamBold,
        TextColor3=theme.Text,TextXAlignment=Enum.TextXAlignment.Left,
        ZIndex=52,Parent=inner
    })
    local body = Util.new("TextLabel",{
        Size=UDim2.new(1,0,0,28),Position=UDim2.new(0,0,0,26),
        BackgroundTransparency=1,
        Text=cfg.Content or "",
        TextSize=11,Font=Enum.Font.Gotham,
        TextColor3=theme.TextMuted,
        TextXAlignment=Enum.TextXAlignment.Left,
        TextWrapped=true,
        ZIndex=52,Parent=inner
    })

    AnimCtrl:tween(card,{Size=UDim2.new(0,260,0,64)},0.22)

    -- repositiona stack
    local yOff = -10
    for _, c in ipairs(self._stack) do
        yOff = yOff - c.AbsoluteSize.Y - self._gap
    end
    self._stack[#self._stack+1] = card
    card.Position = UDim2.new(1,-270,1,yOff)

    task.delay(dur, function()
        AnimCtrl:tween(card,{BackgroundTransparency=1},0.25)
        AnimCtrl:tween(title,{TextTransparency=1},0.25)
        AnimCtrl:tween(body,{TextTransparency=1},0.25)
        task.wait(0.26)
        for i,c in ipairs(self._stack) do
            if c==card then table.remove(self._stack,i); break end
        end
        card:Destroy()
    end)
end

