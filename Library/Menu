    local _events = {}
    local _destroyed=false

    local f=Util.new("Frame",{
        Size=UDim2.new(1,0,0,38),LayoutOrder=order,
        BackgroundColor3=theme.Surface,BorderSizePixel=0,
        ZIndex=8,ClipsDescendants=false,Parent=parent
    })
    Util.corner(f,8)
    Util.stroke(f,theme.Border,1)

    local header=Util.new("TextButton",{
        Size=UDim2.new(1,0,0,38),BackgroundTransparency=1,
        Text="",ZIndex=9,Parent=f
    })
    local nameLbl=Util.new("TextLabel",{
        Size=UDim2.new(0.6,0,1,0),Position=UDim2.new(0,12,0,0),
        BackgroundTransparency=1,Text=cfg.Name or "Dropdown",
        TextSize=12,Font=Enum.Font.GothamBold,
        TextColor3=theme.Text,TextXAlignment=Enum.TextXAlignment.Left,ZIndex=10,Parent=header
    })
    Rainbow:add(nameLbl,math.random())
    local selLbl=Util.new("TextLabel",{
        Size=UDim2.new(0.38,0,1,-8),Position=UDim2.new(0.6,0,0,4),
        BackgroundColor3=theme.Surface2,BackgroundTransparency=0,
        Text=selected or "Selecionar",TextSize=11,Font=Enum.Font.Gotham,
        TextColor3=theme.TextMuted,ZIndex=10,Parent=header
    })
    Util.corner(selLbl,5)
    local arr=Util.new("TextLabel",{
        Size=UDim2.new(0,16,1,0),Position=UDim2.new(1,-20,0,0),
        BackgroundTransparency=1,Text="▾",TextSize=12,Font=Enum.Font.GothamBold,
        TextColor3=theme.Accent,ZIndex=10,Parent=header
    })

    -- dropdown panel
    local panel=Util.new("Frame",{
        Size=UDim2.new(1,0,0,0),Position=UDim2.new(0,0,1,2),
        BackgroundColor3=theme.Surface2,BorderSizePixel=0,
        ZIndex=20,ClipsDescendants=true,Visible=false,Parent=f
    })
    Util.corner(panel,8)
    Util.stroke(panel,theme.Border,1)
    Util.listLayout(panel,nil,2)
    Util.pad(panel,4,4,4,4)

    local function close()
        open=false; arr.Text="▾"
        AnimCtrl:tween(panel,{Size=UDim2.new(1,0,0,0)})
        task.delay(0.16,function() panel.Visible=false end)
    end

    local function pick(opt)
        selected=opt; selLbl.Text=opt
        if cfg.Flag then StateManager:set(cfg.Flag,opt) end
        if cfg.Callback and not _destroyed then pcall(cfg.Callback,opt) end
        for _,fn in ipairs(_events) do pcall(fn,opt) end
        close()
    end

    -- build options
    local totalH=0
    for i,opt in ipairs(options) do
        totalH=totalH+28+2
        local ob=Util.new("TextButton",{
            Size=UDim2.new(1,0,0,26),BackgroundColor3=theme.Surface,
            BackgroundTransparency=0.4,Text=opt,TextSize=11,
            Font=Enum.Font.Gotham,TextColor3=theme.Text,LayoutOrder=i,
            ZIndex=21,Parent=panel
        })
        Util.corner(ob,5)
        ob.MouseButton1Click:Connect(function() pick(opt) end)
    end
    totalH=math.min(totalH, 120)

    local c1=header.MouseButton1Click:Connect(function()
        open=not open
        arr.Text=open and "▴" or "▾"
        panel.Visible=true
        AnimCtrl:tween(panel,{Size=UDim2.new(1,0,0,open and totalH or 0)})
        if not open then task.delay(0.16,function() panel.Visible=false end) end
    end)
    janitor:add(c1)

    local obj={_frame=f}
    function obj:Set(v) pick(v) end
    function obj:Get() return selected end
    function obj:OnChanged(fn) _events[#_events+1]=fn end
    function obj:SetVisible(v) f.Visible=v end
    function obj:Destroy() _destroyed=true; f:Destroy() end
    return obj
end

